R reference


System.Window MainWindow
	size.width: 800
	size.height: 600
	title: "Test"

	Text
		write: "Hej" +  "Hi", "bob",
		self.Image
		size.width:  800px
		size.height: 600px
		+ struct:
			apple: 1
			pie: 2
			'a'
			
	View
		layout.direction: 'vertical'
		self._Horizontal.size.width: "im a property
		for sure"

		+ _Hover: [argument * anotherArgument = 'true']
			size.width: 1600px
			size.height: 200px

		self_Hover: ['new_Argument_For_Why_Hover_Should_Be_Active']

		Repeat
			times: 4

			Image
				source: "/hi" + index +
				 ".jpg"






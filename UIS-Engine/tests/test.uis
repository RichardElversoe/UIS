"Standard.uis" Testing {}

Testing.Group Button
{
    padding: 1em
    layout: {
        direction: 'horizontal'
    }
    + label: "new button"
    + source: ""
    + testValue: 1 //<- write it as text will force every future value, to be read as a string of text.
    + NUMBER testNumber: 1
    testValue: "nothing yet"
    testValue: "testing" + label
    testValue: label
    testValue: "hello" + "world"
    testValue: 'label'
    testValue: 'label' + "world"
    testValue: 'label' + A
    testValue: 10 + "world"
    testValue: B
    testValue: (B)
    testValue: (10)
    testValue: X | 10
    testValue: 10 | X
    testValue: X | Y
    testValue: 30 * 5 - (1 * X | 2)
    testValue: Back, 10

    Testing.Image I {
        + soruce: "" //the '+' should not be nescessary here, as it should've been inherited from Image, and needs to be studied further
    }

    Testing.Text T {
        opacity: [parent.isHovered] 1 | 0
        write: parent.label
        
        [100 > width < 200] perfectWidth
        {
            color: 'green' //Effects the color property of Text ()
        }
    }
}

Testing.Window MainWindow
{
    title: "Hi!"
    width: 100px
    height: 200px
    + fill: 'blue'

    Testing.Group Menu
    {
        Button { label: "minimize" ; source: "../icons/test.svg"}
        Button { label: "maximize" }
        Button { label: "close" }
    }
}
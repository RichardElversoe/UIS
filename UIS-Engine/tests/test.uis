// forward(1)
// forward(2)
// forward(3)
// back(2) -> forward(3)
// back(2) -> back(1) -> forward(2)
// back(1) -> back(0) -> forward(1)
// forward(2)
// back(1) -> addModVec -> goto(2)
// forward(3)
// back(2) -> removeModVec -> back(1) -> forward(2)
// back(1) -> back(0) -> forward(1)

// + rootTest: 200

+ Window
	+ Test
+ General  //imply new - when a Base is prefixed by '+', all subsequent, bases must also imply the use of '+' (since they live inside something not previously defined)
	+ number: 1 + 2
		+ a: 2
		+ b: 2
	+ c: 2
	text: "hello world"
	color: #8080ff
	reference: @Window
	structure: 
		a: 1 <~ 20%
		b: "contains all types of data" 
		NUMBER.UNSIGNED c: 1_000_000

	structure.a: 90% parent.height
	option:
		'true'
		'false'
		'schrodinger'

General Icon
	+ sources: 10
		opt: OPTION
		src: TEXT

	sources: 	('a', "folder/path/a.jpg"),
				('b', "folder/path/a.jpg"),
				('c', "folder/path/a.jpg"),
				('d', "folder/path/a.jpg"),
				('e', "folder/path/a.jpg"),

	source: sources.src[sources.opt]

	sources.opt: 'e'

Window
	title: "hello world"
	size: [mode: 'resizeable'] (800, 600) | (600, 400)

	// General(size: (800,600); name: "test")


Window
TestEnd